import {
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/argparse",
  "moonbitlang/async/stdio",
  "moonbitlang/async/process",
  "moonbitlang/x/path",
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbit-community/chalk",
  "kokic/momoka/core",
}

supported_targets = "+native+wasm"

pkgtype(kind: "executable")

options(
  targets: {
    "commands.mbt": [ "native" ],
    "configure.mbt": [ "native" ],
    "preferred.mbt": [ "native" ],
    "toolchain.mbt": [ "native" ],
    "upgrade.mbt": [ "native" ],
    "username.mbt": [ "native" ],
    "username_wasm.mbt": [ "wasm" ],
  },
)
